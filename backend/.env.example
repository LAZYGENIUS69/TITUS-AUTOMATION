EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=Your Organization <verified-sender@example.com>
EMAIL_SUBJECT=Your Certificate of Completion
EMAIL_BODY=<p>Hello,<br><br>Thank you for participating! Please find your personalized certificate of completion attached to this email.<br><br>Best regards,<br>Event Team</p>
BREVO_FORCE_IPV4=true
AUTH_SECRET=replace-with-a-long-random-secret
